package frc.robot.commands.mechanism;

public class PassToEndEffector extends Commands{
    private Intake intake;
    private EndEffector endEffector;
    private final Trigger gamepieceInIntake =
        new Trigger(() -> RobotStates.coralInIntake).debounce(0.5);
    
    /** Creates a new IntakGround */
  public PassToEndEffector(Intake intake, EndEffector endEffector) {

    this.intake = intake;
    this.endEffector = endEffector;

    // Use addRequirements() here to declare subsystem dependencies.
    addRequirements(intake);
    addRequirements(endEffector);
  }
// Called when the command is initially scheduled.
@Override
public void initialize() {}

// Called every time the scheduler runs while the command is scheduled.
@Override
public void execute() {
  intake.setPivotAngle(PivotConstants.PASSOFF_PIVOT_ANGLE);
  intake.setRollerVelocity(0);
  arm.setPivotAngle(ArmConstants.PASSOFF_ARM_ANGLE);
  elevator.elevatorHeight(ElevatorConstants.SAFE_HEIGHT);
  endEffector.setVelocity(EndEffectorConstants.SUPPLY_CURRENT_LIMIT);
}

// Called once the command ends or is interrupted.
@Override
public void end(boolean interrupted) {
  intake.setPivotAngle(PivotConstants.HOME_POSITION);
  intake.setRollerVelocity(0);
}

// Returns true when the command should end.
@Override
public boolean isFinished() {
  return RobotStates.coralInEndEffector;
}
}
